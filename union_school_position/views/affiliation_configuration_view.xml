<odoo>
        <record model="ir.ui.view" id="union_school_position_affiliation_configuration_form">
            <field name="name">union_school_position.union_affiliate_configuration.form</field>
            <field name="model">affiliation.affiliation_configuration</field>
            <field name="inherit_id"
                ref="union_affiliation.union_affiliation_affiliation_configuration_form" />
            <field name="arch" type="xml">
                <xpath expr="//form/sheet" position="inside">
                    <h2>School Position's configuration</h2>
                    <group>
                        <field name="create_user_from_position" />
                    </group>
                </xpath>
            </field>
        </record>
</odoo>
