<odoo>
    <data>
        <record model="ir.ui.view" id="union_school_position_form">
            <field name="name">School position form</field>
            <field name="model">school_position.position</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="affiliate_id" />
                            <field name="type_id" />
                            <field name="type_id_in_hours" invisible="1" />
                            <field name="position_number" />
                            <field name="hs_amount"
                                attrs="{'invisible': [('type_id_in_hours', '=', False)], 'required': [('type_id_in_hours', '=', True)]}" />
                            <field name="character_id" />
                            <field name="workplace_id" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="featured" />
                            <field name="registration_date" />
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes"
                                    placeholder="Additional notes or observations..." />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="union_school_position_tree">
            <field name="name">School position tree</field>
            <field name="model">school_position.position</field>
            <field name="arch" type="xml">
                <tree decoration-info="featured">
                    <field name="affiliate_id" />
                    <field name="type_id" />
                    <field name="position_number" />
                    <field name="hs_amount" />
                    <field name="character_id" />
                    <field name="workplace_id" />
                    <field name="date_from" />
                    <field name="date_to" />
                    <field name="featured" />
                    <field name="registration_date" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="union_school_position_search">
            <field name="name">School position search</field>
            <field name="model">school_position.position</field>
            <field name="arch" type="xml">
                <search string="Position filters">
                    <field name="affiliate_id"
                        filter_domain="['|','|',('affiliate_id.name', 'ilike', self),('affiliate_id.uid', 'ilike', self),('affiliate_id.personal_id', 'ilike', self)]" />
                    <field name="type_id"
                        filter_domain="['|',('type_id.name', 'ilike', self),('type_id.code', 'ilike', self)]" />
                    <field name="workplace_id"
                        filter_domain="['|','|',('workplace_id.name', 'ilike', self),('workplace_id.code', 'ilike', self),('workplace_id.complete_name', 'ilike', self)]" />
                    <field name="character_id"
                        filter_domain="['|',('character_id.name', 'ilike', self),('character_id.code', 'ilike', self)]" />

                    <group expand="1" string="Group By">
                        <filter string="Workplace" name='workplace_id'
                            context="{'group_by':'workplace_id'}" />
                        <filter string="Featured" name='featured'
                            context="{'group_by':'featured'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="action_set_featured" model="ir.actions.server">
            <field name="name">Set Featured</field>
            <field name="model_id" ref="model_school_position_position" />
            <field name="binding_model_id" ref="model_school_position_position" />
            <field name="state">code</field>
            <field name="code">
                records.action_set_featured()
            </field>

        </record>

        <record id="action_unset_featured" model="ir.actions.server">
            <field name="name">Unset Featured</field>
            <field name="model_id" ref="model_school_position_position" />
            <field name="binding_model_id" ref="model_school_position_position" />
            <field name="state">code</field>
            <field name="code">
                records.action_unset_featured()
            </field>

        </record>

    </data>
</odoo>