<odoo>
        <record model="ir.ui.view" id="union_benefit_request_form">
            <field name="name">union_benefit_request_form</field>
            <field name="model">benefit_request.benefit_request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Submit Request" class="btn btn-primary" type="object"
                            name="request" invisible="state not in ['draft']" />
                        <button string="Authorize" class="btn btn-primary" type="object"
                            name="authorize" invisible="state not in ['requested']"
                            groups="union_benefit_request.group_benefit_request_admin" />
                        <button string="Reject" class="btn btn-primary" type="object" name="reject"
                            invisible="state not in ['requested']"
                            groups="union_benefit_request.group_benefit_request_admin" />
                        <button string="Finalize" class="btn btn-primary" type="object"
                            name="finalize" invisible="state not in ['authorized']" />
                        <button string="Cancel" class="btn btn-secondary" type="object"
                            name="cancel"
                            invisible="state not in ['draft', 'requested', 'authorized', 'finalized']" />
                        <button string="Return to Draft" class="btn btn-secondary" type="object"
                            name="set_to_draft"
                            invisible="state not in ['requested', 'authorized', 'rejected']" />
                        <button string="Return to Draft" class="btn btn-secondary" type="object"
                            name="set_to_draft" invisible="state not in ['finalized', 'canceled']"
                            groups="union_benefit_request.group_benefit_request_admin" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <group>
                            <group string="Request" name="request">
                                <field name="request_type_id"
                                    readonly="state not in ['draft']"
                                    domain="[('active','=',True)]" options="{'no_create': True}" />
                                <field name="partner_id" readonly="state not in ['draft']" />
                                <field name="expedient" readonly="state not in ['draft']" />
                                <field name="full_doc"
                                    readonly="state not in ['draft', 'authorized']" />
                                <field name="observations" readonly="state not in ['draft']" />
                                <field name="hide_school_benefits" invisible="1" />
                                <field name="hide_amounts" invisible="1" />
                                <field name="hide_notes" invisible="1" />
                            </group>
                            <group string="Other information" name="other_information">
                                <field name="responsible"
                                    readonly="state in ['canceled', 'rejected']" />
                                <field name="request_date" readonly="1" />
                                <field name="last_change_state" readonly="1" />
                                <field name="last_state" readonly="1" />
                                <field name="survey_user_input_id" readonly="1" />
                            </group>
                        </group>
                        <notebook>
                            <page string="School benefits" name="school_benefits"
                                invisible="hide_school_benefits">
                                <field name="school_benefit_ids"
                                    readonly="state not in ['draft', 'authorized']"
                                    options="{'create': [('state', 'in', ['draft'])], 'delete': [('state', 'in', ['draft'])]}">
                                    <list editable="bottom">
                                        <field name="state" column_invisible="True" />
                                        <field name="school_benefit_type_id"
                                            readonly="state in ['authorized']" />
                                        <field name="affiliate_child_id"
                                            readonly="state in ['authorized']" />
                                        <field name="delivered" />
                                    </list>
                                </field>
                            </page>
                            <page string="Amounts" name="amounts" invisible="hide_amounts">
                                <group>
                                    <field name="requested_amount"
                                        readonly="state not in ['draft']" />
                                    <field name="authorized_amount"
                                        readonly="state not in ['requested']" />
                                    <field name="paid_amount" readonly="state != 'authorized'" />
                                </group>
                            </page>
                            <page string="Notes" name="notes" invisible="hide_notes">
                                <field name="notes"
                                    readonly="state not in ['draft', 'requested', 'authorized']" />
                            </page>
                        </notebook>
                    </sheet>

                    <chatter />

                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="union_benefit_request_tree">
            <field name="name">union_benefit_request.tree</field>
            <field name="model">benefit_request.benefit_request</field>
            <field name="arch" type="xml">
                <list>
                    <field name="request_date" />
                    <field name="partner_id" />
                    <field name="request_type_id" />
                    <field name="expedient" />
                    <field name="full_doc" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="union_benefit_request_search" model="ir.ui.view">
            <field name="name">union_benefit_request.search</field>
            <field name="model">benefit_request.benefit_request</field>
            <field name="arch" type="xml">
                <search string="Request filters">
                    <field name="partner_id" filter_domain="[('partner_id.name', 'ilike', self)]" />
                    <field name="request_type_id"
                        filter_domain="[('request_type_id.name', 'ilike', self)]" />

                    <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]" />
                    <filter string="Requested" name="state_requested"
                        domain="[('state', '=', 'requested')]" />
                    <filter string="Authorized" name="state_authorized"
                        domain="[('state', '=', 'authorized')]" />
                    <filter string="Rejected" name="state_rejected"
                        domain="[('state', '=', 'rejected')]" />
                    <filter string="Finalized" name="state_finalized"
                        domain="[('state', '=', 'finalized')]" />
                    <filter string="Canceled" name="state_canceled"
                        domain="[('state', '=', 'canceled')]" />
                    <field name="state" />
                    <separator />
                    <filter string="Full documented" name="full_documented"
                        domain="[('full_doc', '=', True)]" />
                    <filter string="Not Full documented" name="not_full_documented"
                        domain="[('full_doc', '=', False)]" />
                    <field name="full_doc" />

                    <separator />
                    <filter string="Full documented" name="full_documented"
                        context="{'group_by':'full_doc'}" />
                    <filter string="State" name="contributors" context="{'group_by':'state'}" />
                    <filter string="Type" name="type" context="{'group_by':'request_type_id'}" />
                    <filter string="Request date" name="request_date"
                        context="{'group_by':'request_date'}" />
                </search>
            </field>
        </record>

        <record id="action_request_mass_mail" model="ir.actions.act_window">
            <field name="name">Send email to aplicants</field>
            <field name="res_model">mail.compose.message</field>
            <field name="binding_model_id" ref="model_benefit_request_benefit_request" />
            <field name="binding_view_types">list</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_composition_mode': 'mass_mail'}</field>
        </record>

        <record id="action_benefit_request_mail_form" model="ir.actions.act_window">
            <field name="name">Send email</field>
            <field name="res_model">mail.compose.message</field>
            <field name="binding_model_id" ref="model_benefit_request_benefit_request" />
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

</odoo>
