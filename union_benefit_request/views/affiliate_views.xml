<odoo>
        <record model="ir.ui.view" id="request_affiliation_affiliate_form">
            <field name="name">request.affiliation.affiliate.form</field>
            <field name="model">affiliation.affiliate</field>
            <field name="inherit_id" ref="union_affiliation.union_affiliation_affiliate_form" />
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook" position="inside">
                    <page name="benefit" string="Benefit requests">
                        <field name="benefit_request_ids" readonly="True">
                            <list>
                                <field name="request_date" />
                                <field name="request_type_id" />
                                <field name="expedient" />
                                <field name="full_doc" />
                                <field name="state" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
</odoo>
