<odoo>
        <record model="ir.ui.view" id="inconsistencies_result_tree">
            <field name="name">inconsistencies.result.tree</field>
            <field name="model">inconsistencies.result</field>
            <field name="arch" type="xml">
                <list string="Inconsistencies" create="false" edit="false">
                    <field name="affiliate_id" widget="many2one" />
                    <field name="status" />
                    <field name="affiliate_state" />
                    <field name="quote" />
                    <field name="affiliate_type_id" />
                    <field name="query_date" />
                    <field name="from_date" />
                    <field name="to_date" />
                    <field name="description" />
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="inconsistencies_result_form">
            <field name="name">inconsistencies.result.form</field>
            <field name="model">inconsistencies.result</field>
            <field name="arch" type="xml">
                <form string="Inconsistency" create="false" edit="false">
                    <sheet>
                        <group>
                            <field name="affiliate_id" widget="many2one" />
                            <field name="status" />
                            <field name="affiliate_state" />
                            <field name="affiliate_type_id" />
                            <field name="query_date" />
                            <field name="from_date" />
                            <field name="to_date" />
                            <field name="description" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="union_contribution_inconsistencies_result_filter">
            <field name="name">inconsistencies.result.search</field>
            <field name="model">inconsistencies.result</field>
            <field name="arch" type="xml">
                <search string="Resultados">
                    <filter string="Agrupar por Descripción" name="group_description"
                        context="{'group_by':'description'}" />
                    <filter string="Agrupar por Situación" name="group_status"
                        context="{'group_by':'status'}" />
                    <filter string="Agrupar por Estado de afiliación" name="group_affiliate_state"
                        context="{'group_by':'affiliate_state'}" />
                    <filter string="Agrupar por Estado cotizante" name="group_quote"
                        context="{'group_by':'quote'}" />
                    <filter string="Agrupar por Tipo de relación laboral"
                        name="group_affiliate_type" context="{'group_by':'affiliate_type_id'}" />
                </search>
            </field>
        </record>

        <record id="view_change_state_wizard_form" model="ir.ui.view">
            <field name="name">inconsistencies.change.state.wizard.form</field>
            <field name="model">inconsistencies.change_state_wizard</field>
            <field name="arch" type="xml">
                <form string="Cambiar Estado">
                    <group>
                        <field name="inconsistency_ids" widget="many2many_tags" readonly="1" />
                        <field name="new_state" />
                        <field name="affiliate_type_id"
                            invisible="new_state in ['new', 'not_affiliated']" />
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirmar" type="object"
                            class="btn-primary" />
                        <button string="Cancelar" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_change_state_wizard" model="ir.actions.act_window">
            <field name="name">Cambiar Estado de Afiliación</field>
            <field name="res_model">inconsistencies.change_state_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_inconsistencies_result" />
            <field name="binding_view_types">form,list</field>
        </record>

        <record id="action_set_quote_server" model="ir.actions.server">
            <field name="name">Cambiar a Cotizante</field>
            <field name="model_id" ref="model_inconsistencies_result" />
            <field name="binding_model_id" ref="model_inconsistencies_result" />
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                records.action_set_quote()
            </field>
        </record>

        <record id="action_unset_quote_server" model="ir.actions.server">
            <field name="name">Cambiar a No Cotizante</field>
            <field name="model_id" ref="model_inconsistencies_result" />
            <field name="binding_model_id" ref="model_inconsistencies_result" />
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                records.action_unset_quote()
            </field>
        </record>

</odoo>
